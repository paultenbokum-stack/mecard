# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://mecard:mecard_dev@127.0.0.1:5435/mecard

# Auth.js — generate with: npx auth secret   (or any long random string)
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3000
# Optional Google sign-in (leave blank to hide the button)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_AUTH_GOOGLE=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# A MySQL copy of the WordPress database, used by `npm run import:wp`
# (WAMP: import toolset-export/mecard_wp.sql into a database called mecard_wp)
WP_DATABASE_URL=mysql://root:@127.0.0.1:3306/mecard_wp

# Email (Resend). Blank = emails are printed in the terminal instead.
RESEND_API_KEY=
EMAIL_FROM=MeCard <info@mecard.co.za>
CONTACT_TO=info@mecard.co.za

# Google Analytics 4 for card pages (blank = off). Production: G-3SRCS4Y6TR
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Images. Production: MEDIA_BUCKET holds the WebP masters, ARCHIVE_BUCKET every
# original WordPress upload under its upload path (2024/03/photo.jpg).
# Without them, originals are read from LOCAL_UPLOADS_DIR (default:
# ../wp-content/uploads next to this app) and masters cached in .media-cache/.
MEDIA_BUCKET=
ARCHIVE_BUCKET=
LOCAL_UPLOADS_DIR=

# Salt for the hashed IP and user agent in analytics events (default: AUTH_SECRET)
TRACKING_SALT=

# /t/ pages honour each card's auto-download-vCard setting; "off" disables it.
MECARD_VCARD_AUTO_DOWNLOAD=

# Shop: PayFast (blank merchant = checkout still works locally with "Simulate
# successful payment"; PAYFAST_SANDBOX=1 for sandbox credentials)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=
# Bob Go courier rates and shipments (blank = fixed Standard / Express / pickup)
BOBGO_API_KEY=
BOBGO_SANDBOX=
# Where "new order" emails go (default: CONTACT_TO)
ORDER_NOTIFY_TO=
# Scheduled jobs (reminder emails, basket clean-up): Cloud Scheduler calls
# /api/cron/automations/ hourly with "Authorization: Bearer <CRON_SECRET>". 16+ characters.
CRON_SECRET=
