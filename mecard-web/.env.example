# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://mecard:mecard_dev@127.0.0.1:5435/mecard

# Auth.js — generate with: npx auth secret   (or any long random string)
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3000
# Optional Google sign-in (leave blank to hide the button)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_AUTH_GOOGLE=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# A MySQL copy of the WordPress database, used by `npm run import:wp`
# (WAMP: import toolset-export/mecard_wp.sql into a database called mecard_wp)
WP_DATABASE_URL=mysql://root:@127.0.0.1:3306/mecard_wp

# Email (Resend). Blank = emails are printed in the terminal instead.
RESEND_API_KEY=
EMAIL_FROM=MeCard <info@mecard.co.za>
CONTACT_TO=info@mecard.co.za
