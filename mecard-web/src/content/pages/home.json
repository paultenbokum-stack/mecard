  "html": "<div style=\"height:40px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<div class=\"wp-block-toolset-blocks-container tb-container\" data-toolset-blocks-container=\"1\">\n<div class=\"wp-block-columns is-layout-flex wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:70%\">\n<h2 id=\"electronic-and-tech-savvy-smart-business-cards\" class=\"wp-block-heading\" style=\"padding-right:0;padding-left:0;font-size:26px\">Electronic and tech-savvy smart business cards. </h2>\n\n<h2 id=\"made-for-functionality-designed-to-make-a-lasting-impression\" class=\"wp-block-heading\" style=\"padding-right:0;padding-left:0;font-size:26px\">Built for functionality. Designed to make a lasting impression.</h2>\n\n<p style=\"padding-right:0;padding-left:0;font-size:20px\">Tap your nfc business card on a phone to share contact information instantly</p>\n\n<p>Create a professional profile in 60 seconds. Share it via NFC, QR code, or WhatsApp. No app to install.</p>\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/sign-up/\">Create my free Profile</a></div>\n\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-ast-global-color-3-color has-ast-global-color-4-background-color has-text-color has-background has-link-color wp-element-button\" href=\"/for-teams/\">For my team </a></div>\n</div>\n\n<div style=\"height:0px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n</div>\n\n<div class=\"wp-block-column main-img is-layout-flow wp-block-column-is-layout-flow\" style=\"padding-right:0;padding-left:0;flex-basis:30%\">\n<div style=\"height:2px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<figure class=\"wp-block-image size-full\"><img src=\"/wp-content/uploads/2022/02/custom_bundle_new.png\" alt=\"\" class=\"wp-image-76156\"/></figure>\n</div>\n</div>\n\n<div style=\"height:20px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<hr class=\"wp-block-separator has-css-opacity\"/>\n\n<div style=\"height:46px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<div class=\"wp-block-columns is-layout-flex wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<h6 class=\"wp-block-heading has-text-align-center has-ast-global-color-0-color has-text-color has-link-color\">HOW IT WORKS</h6>\n\n<h2 class=\"wp-block-heading has-text-align-center has-large-font-size\">Live in 60 Seconds</h2>\n\n<div style=\"height:25px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n</div>\n</div>\n\n<div class=\"wp-block-columns  g-4 mc-reveal is-layout-flex wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column jumbotron is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"mc-step-num\">1</div>\n\n<h3 class=\"wp-block-heading mc-step-title\">Sign up</h3>\n\n<p class=\"mc-step-desc\">One-tap login with Google or LinkedIn. No passwords, no forms.</p>\n</div>\n\n<div class=\"wp-block-column jumbotron is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"mc-step-num\">2</div>\n\n<h3 class=\"wp-block-heading mc-step-title\">Build your profile</h3>\n\n<p class=\"mc-step-desc\">Add your name, photo, and contact details. We pre-fill what we can.</p>\n</div>\n\n<div class=\"wp-block-column jumbotron is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"mc-step-num\">3</div>\n\n<h3 class=\"wp-block-heading mc-step-title\">Start sharing</h3>\n\n<p class=\"mc-step-desc\">QR code, WhatsApp, order an NFC card — your profile is instantly shareable.</p>\n</div>\n</div>\n\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<hr class=\"wp-block-separator has-css-opacity\"/>\n\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<div class=\"wp-block-columns is-layout-flex wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<h6 class=\"wp-block-heading has-text-align-center has-ast-global-color-0-color has-text-color has-link-color\">PRICING</h6>\n\n<h2 class=\"wp-block-heading has-text-align-center\">Start free. Upgrade when you're ready</h2>\n\n<p class=\"has-text-align-center\">No monthly fees on Free. MeCard Pro is billed annually — that’s it.</p>\n\n<div class=\"row g-4 justify-content-center mc-reveal\">\n      <!-- FREE -->\n      <div class=\"col-md-5 col-lg-5\">\n        <div class=\"mc-price-card\">\n          <div class=\"mc-tier-name\">Free</div>\n          <div class=\"d-flex align-items-baseline gap-1 mb-1\">\n            <span class=\"mc-price\">R0</span>\n          </div>\n          <div class=\"mc-price-sub mb-3\">Free forever — no catch</div>\n          <ul class=\"mc-feature-list\">\n            <li><i class=\"fa-solid fa-check\"></i> Digital profile with shareable link</li>\n            <li><i class=\"fa-solid fa-check\"></i> QR code &amp; WhatsApp sharing</li>\n            <li><i class=\"fa-solid fa-check\"></i> Save to home screen (PWA)</li>\n            <li><i class=\"fa-solid fa-check\"></i> Basic view count</li>\n            <li class=\"mc-feature-muted\"><i class=\"fa-solid fa-xmark\"></i> Company branding &amp; colours</li>\n            <!--<li class=\"mc-feature-muted\"><i class=\"fa-solid fa-xmark\"></i> Lead capture &amp; advanced analytics</li>-->\n            <li class=\"mc-feature-muted\"><i class=\"fa-solid fa-xmark\"></i> Remove MeCard branding</li>\n          </ul>\n          <a href=\"/sign-up/\" class=\"mc-btn mc-btn-outline w-100 mt-3\">Get started free</a>\n        </div>\n      </div>\n \n      <!-- PRO -->\n      <div class=\"col-md-5 col-lg-5\">\n        <div class=\"mc-price-card mc-price-card--featured\">\n          <div class=\"mc-badge-featured\">Recommended</div>\n          <div class=\"mc-tier-name mc-tier-name--pro\">MeCard Pro</div>\n          <div class=\"d-flex align-items-baseline gap-1 mb-1\">\n            <span class=\"mc-price\">R199</span>\n            <!--<span class=\"mc-price-period\">/year</span>-->\n          </div>\n         <!-- <div class=\"mc-price-sub mb-3\">Only R17/month — less than a coffee</div>-->\n          <ul class=\"mc-feature-list\">\n            <li><i class=\"fa-solid fa-check\"></i> <strong>Everything in Free, plus:</strong></li>\n            <li><i class=\"fa-solid fa-check\"></i> WhatsApp button &amp; direct line</li>\n            <li><i class=\"fa-solid fa-check\"></i> Company branding &amp; custom colours</li>\n            <!--<li><i class=\"fa-solid fa-check\"></i> Lead capture — see who viewed your card</li>\n            <li><i class=\"fa-solid fa-check\"></i> Advanced analytics &amp; weekly email</li>-->\n            <li><i class=\"fa-solid fa-check\"></i> Remove MeCard branding</li>\n            <!--<li><i class=\"fa-solid fa-check\"></i> Email signature generator</li>-->\n          </ul>\n          <a href=\"/sign-up/\" class=\"mc-btn mc-btn-primary w-100 mt-3\">Start free, upgrade anytime</a>\n        </div>\n      </div>\n    </div>\n</div>\n</div>\n\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<hr class=\"wp-block-separator has-css-opacity\"/>\n\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<div class=\"wp-block-columns is-layout-flex wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<h6 class=\"wp-block-heading has-text-align-center has-ast-global-color-0-color has-text-color has-link-color\">NFC SMART BUSINESS CARDS</h6>\n\n<h2 class=\"wp-block-heading has-text-align-center\">Add a physical card</h2>\n\n<p class=\"has-text-align-center\">Tap your card on any phone to share your profile instantly. Works with Free or Pro.</p>\n</div>\n</div>\n\n<div class=\"wp-block-columns is-layout-flex wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"mc-card-product\">\n          <img src=\"/wp-content/uploads/2021/12/mecard-front-cropped.png\" alt=\"Classic MeCard\">\n          <div class=\"mc-card-name\">Classic card</div>\n          <div class=\"mc-card-price\">R299</div>\n          <div class=\"mc-card-desc\">White + your logo</div>\n        </div>\n</div>\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"mc-card-product\">\n          <img src=\"/wp-content/uploads/2021/12/mecard-front-cropped.png\" alt=\"Custom MeCard\">\n          <div class=\"mc-card-name\">Custom card</div>\n          <div class=\"mc-card-price\">R399</div>\n          <div class=\"mc-card-desc\">Full custom design</div>\n        </div>\n</div>\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"mc-card-product mc-card-product--best\">\n          <div class=\"mc-badge-value\">Best value</div>\n          <img src=\"/wp-content/uploads/2022/02/custom_bundle_new.png\" alt=\"Classic Bundle\">\n          <div class=\"mc-card-name\">Classic bundle</div>\n          <div class=\"mc-card-price\">R499</div>\n          <div class=\"mc-card-desc\">Card + Pro + phone tag</div>\n        </div>\n</div>\n</div>\n\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<hr class=\"wp-block-separator has-css-opacity\"/>\n\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<div class=\"wp-block-columns is-layout-flex wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<h6 class=\"wp-block-heading has-text-align-center has-ast-global-color-0-color has-text-color has-link-color\">FAQ</h6>\n\n<h2 class=\"wp-block-heading has-text-align-center\">Common Questions</h2>\n\n<div role=\"group\" class=\"wp-block-accordion\">\n<div class=\"wp-block-accordion-item is-open has-medium-font-size\">\n<h3 class=\"wp-block-accordion-heading has-ast-global-color-0-color has-text-color has-link-color has-medium-font-size\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\" style=\"text-decoration:none\">Are there any monthly or recurring fees?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n\n<div role=\"region\" class=\"wp-block-accordion-panel\">\n<p>The Free plan is free forever. MeCard Pro is R199 per year — no monthly charges, no surprises. NFC cards are a once-off purchase. Bundles include the first year of Pro.</p>\n</div>\n</div>\n\n<div class=\"wp-block-accordion-item has-medium-font-size\">\n<h3 class=\"wp-block-accordion-heading has-ast-global-color-0-color has-text-color has-link-color has-medium-font-size\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\" style=\"text-decoration:none\">Do I need to buy a card to use MeCard?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n\n<div role=\"region\" class=\"wp-block-accordion-panel\" hidden>\n<p>Not at all. Your digital profile works immediately via QR code, WhatsApp, and a shareable link. The NFC card is a premium add-on for people who want the physical tap-to-share experience.</p>\n</div>\n</div>\n\n<div class=\"wp-block-accordion-item has-medium-font-size\">\n<h3 class=\"wp-block-accordion-heading has-ast-global-color-0-color has-text-color has-link-color has-medium-font-size\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\" style=\"text-decoration:none\">Can I try it before I pay?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n\n<div role=\"region\" class=\"wp-block-accordion-panel\" hidden>\n<p>Absolutely. Start with a free profile — it's fully functional. You can share it, add it to your home screen, and see your view count. When you're ready for company branding, analytics, and lead capture, upgrade to Pro. Your profile and data carry forward seamlessly.</p>\n</div>\n</div>\n\n<div class=\"wp-block-accordion-item has-medium-font-size\">\n<h3 class=\"wp-block-accordion-heading has-ast-global-color-0-color has-text-color has-link-color has-medium-font-size\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\" style=\"text-decoration:none\">How does the NFC card work?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n\n<div role=\"region\" class=\"wp-block-accordion-panel\" hidden>\n<p>You hold your MeCard up to someone's phone. It instantly opens your digital profile — no app required on their end. They can save your contact details with one tap. It works with virtually all modern iPhones and Android phones.</p>\n</div>\n</div>\n\n<div class=\"wp-block-accordion-item has-medium-font-size\">\n<h3 class=\"wp-block-accordion-heading has-ast-global-color-0-color has-text-color has-link-color has-medium-font-size\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\" style=\"text-decoration:none\">What about teams and companies?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n\n<div role=\"region\" class=\"wp-block-accordion-panel\" hidden>\n<p>If you need profiles and cards for your team, tap \"For my team\" on the signup page. You'll get team management, centralised branding, and bulk card ordering. Each team member gets their own profile that they can share independently.</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<div class=\"wp-block-columns is-layout-flex wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<section class=\"mc-section-sm\">\n  <div class=\"container mc-reveal\">\n    <div class=\"mc-cta-banner text-center text-lg-start\">\n      <div class=\"row align-items-center\">\n        <div class=\"col-lg-7\">\n          <h2 class=\"mc-cta-heading\">Ready to make an impression?</h2>\n          <p class=\"mc-cta-text mb-4 mb-lg-0\">\n            Create your free digital business card in 60 seconds. No credit card, no commitment.\n          </p>\n        </div>\n        <div class=\"col-lg-5 text-lg-end text-center\">\n        <div class=\"d-flex flex-column align-items-center align-items-lg-end\" style=\"gap: 5px;\">\n    <a href=\"/sign-up/\" class=\"wp-block-button__link wp-element-button\">Create my free profile</a>\n    <a href=\"/for-teams/\" class=\"wp-block-button__link has-ast-global-color-3-color has-ast-global-color-4-background-color has-text-color has-background has-link-color wp-element-button\">For my team <i class=\"fa-solid fa-arrow-right ms-1\"></i></a>\n</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n</div>\n</div>\n\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<hr class=\"wp-block-separator has-css-opacity\"/>\n\n<div class=\"mc-when-out\">\n<div class=\"tb-button add-button-full\" data-toolset-blocks-button=\"1\"><a class=\"tb-button__link\" href=\"/sign-up/\"><i class=\"tb-button__icon\"></i><span class=\"tb-button__content\">Create Your Free Account Now</span></a></div>\n</div>\n\n<div class=\"mc-when-in\">\n<div class=\"tb-button add-button-full\" data-toolset-blocks-button=\"1\"><a class=\"tb-button__link\" href=\"/manage/\"><i class=\"tb-button__icon\"></i><span class=\"tb-button__content\">Go to Console</span></a></div>\n</div>\n\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n</div>"
}
